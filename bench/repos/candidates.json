{
  "about": "The 50 public repositories the readers run over (step 1.10 of Genter's open-source plan). Written before any count was taken; run.mjs --pick checks each candidate in this order and takes the first `take` of each group that passes, then pins their commits in repos.json. Stars are GitHub's stargazers_count on stars_on.",
  "stars_on": "2026-10-20",
  "rule": "Public GitHub repositories that keep decision records or deprecation notices, in three groups. In each group the candidates are every repository of that kind we could name with the group's minimum of stars, most stars first, and the first `take` that pass the group's check are taken: the check looks only at whether the records named are in the tree, never at what the readers find in them.",
  "groups": [
    {
      "id": "archives",
      "title": "Decision archives",
      "take": 18,
      "rule": "A repository that holds the proposals of a language, framework or protocol (PEPs, RFCs, KEPs, EIPs, BIPs, NIPs, MSCs, design documents, or a tracking list of them), 1,000 stars or more. Check: a file of the records named is in the tree.",
      "candidates": [
        { "repo": "tc39/proposals", "stars": 19199, "records": "^(README|finished-proposals|inactive-proposals)\\.md$", "what": "tracking lists of ECMAScript proposals" },
        { "repo": "swiftlang/swift-evolution", "stars": 15885, "records": "^proposals/\\d{4}-.+\\.md$", "what": "Swift Evolution proposals" },
        { "repo": "ethereum/EIPs", "stars": 14036, "records": "^EIPS/eip-\\d+\\.md$", "what": "Ethereum Improvement Proposals" },
        { "repo": "dotnet/csharplang", "stars": 12719, "records": "^proposals/.+\\.md$", "what": "C# language proposals" },
        { "repo": "WebAssembly/design", "stars": 11628, "records": "^[^/]+\\.md$", "what": "WebAssembly design documents" },
        { "repo": "bitcoin/bips", "stars": 10979, "records": "^bip-\\d+\\.(mediawiki|md)$", "what": "Bitcoin Improvement Proposals" },
        { "repo": "rust-lang/rfcs", "stars": 6612, "records": "^text/\\d{4}-.+\\.md$", "what": "Rust RFCs" },
        { "repo": "reactjs/rfcs", "stars": 5818, "records": "^text/\\d{4}-.+\\.md$", "what": "React RFCs" },
        { "repo": "python/peps", "stars": 5029, "records": "^peps/pep-\\d{4}\\.rst$", "what": "Python Enhancement Proposals" },
        { "repo": "vuejs/rfcs", "stars": 4927, "records": "^active-rfcs/\\d{4}-.+\\.md$", "what": "Vue RFCs" },
        { "repo": "kubernetes/enhancements", "stars": 3972, "records": "^keps/.+/kep\\.yaml$", "what": "Kubernetes Enhancement Proposals" },
        { "repo": "Kotlin/KEEP", "stars": 3774, "records": "^proposals/.+\\.md$", "what": "Kotlin Evolution and Enhancement Process" },
        { "repo": "golang/proposal", "stars": 3459, "records": "^design/\\d+-.+\\.md$", "what": "Go design documents" },
        { "repo": "nostr-protocol/nips", "stars": 3120, "records": "^[0-9A-F]{2}\\.md$", "what": "Nostr Implementation Possibilities" },
        { "repo": "dart-lang/language", "stars": 2936, "records": "^accepted/.+\\.md$", "what": "Dart language feature specifications" },
        { "repo": "tensorflow/community", "stars": 1289, "records": "^rfcs/.+\\.md$", "what": "TensorFlow RFCs" },
        { "repo": "matrix-org/matrix-spec-proposals", "stars": 1261, "records": "^proposals/\\d+-.+\\.md$", "what": "Matrix spec change proposals" },
        { "repo": "WebAssembly/proposals", "stars": 1139, "records": "^(README|finished-proposals|inactive-proposals)\\.md$", "what": "a tracking list of WebAssembly proposals" }
      ]
    },
    {
      "id": "in-tree",
      "title": "Decision records in a project's own tree",
      "take": 16,
      "rule": "A well-known project, 1,000 stars or more, that keeps its own decision records (ADRs, RFCs, RFDs, design proposals or specs) in a folder of its main repository. Check: a record in that folder is in the tree.",
      "candidates": [
