        { "repo": "thomvaill/log4brains", "stars": 1603, "records": "^docs/adr/\\d{8}-.+\\.md$", "what": "ADRs" }
      ]
    },
    {
      "id": "changelogs",
      "title": "Deprecation notices in a changelog",
      "take": 16,
      "rule": "A well-known project, 10,000 stars or more, that keeps deprecation notices in a changelog: a file named CHANGELOG, CHANGES, HISTORY or RELEASES (any extension, any folder) whose text says \"deprecat\" at least once. Check: such a file is in the tree.",
      "changelog": true,
