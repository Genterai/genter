        { "repo": "open-telemetry/opentelemetry-collector", "stars": 7682, "records": "^docs/rfcs/.+\\.md$", "what": "RFCs" },
        { "repo": "cosmos/cosmos-sdk", "stars": 7078, "records": "^docs/architecture/adr-\\d+.+\\.md$", "what": "ADRs" },
        { "repo": "cortexproject/cortex", "stars": 5878, "records": "^docs/proposals/.+\\.md$", "what": "proposals" },
        { "repo": "npryce/adr-tools", "stars": 5735, "records": "^doc/adr/\\d{4}-.+\\.md$", "what": "ADRs" },
