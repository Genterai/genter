{
  "name": "genter-cli",
  "version": "0.3.0",
  "description": "Resolver for AI agents: a question resolves to where its answer is written, read again every time. No keys, no packages. CLI, MCP server and library.",
  "keywords": [
    "ai",
    "agents",
    "resolver",
    "memory",
    "mcp",
    "mcp-server",
    "rag",
    "retrieval",
    "search",
    "claude-code",
    "cursor",
    "llm",
    "context",
    "bm25",
    "cli"
  ],
  "homepage": "https://genter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genterai/genter.git"
  },
  "bugs": {
    "url": "https://github.com/Genterai/genter/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "genter": "bin/genter.js"
  },
  "exports": {
    ".": "./src/local.js",
    "./local": "./src/local.js",
    "./lexical": "./src/lexical.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "biome lint .",
    "bench": "node bench/drift/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
