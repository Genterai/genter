{
  "name": "genter-cli",
  "version": "0.3.1",
  "mcpName": "io.github.Genterai/genter",
  "description": "Your AI stops quoting the old answer. Genter shows your AI what your team decided, where it is written and when, and marks what was replaced since. CLI, MCP server and library: no key, no dependencies.",
  "keywords": [
    "ai",
    "agents",
    "decisions",
    "adr",
    "memory",
    "mcp",
    "mcp-server",
    "rag",
    "retrieval",
    "search",
    "claude-code",
    "cursor",
    "llm",
    "context",
    "bm25",
    "cli"
  ],
  "homepage": "https://genter.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genterai/genter.git"
  },
  "bugs": {
    "url": "https://github.com/Genterai/genter/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "genter": "bin/genter.js"
  },
  "exports": {
    ".": "./src/local.js",
    "./local": "./src/local.js",
    "./lexical": "./src/lexical.js",
    "./readers": "./src/readers.js",
    "./conformance": "./src/conformance.js"
  },
  "files": [
    "bin",
    "src",
    "readers/reader.schema.json",
    "readers/*/reader.json",
    "rules/*.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "biome lint .",
    "bench": "node bench/drift/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
