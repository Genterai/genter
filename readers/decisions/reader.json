{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "decisions",
  "owner": "@Genterai",
  "matches": {
    "files": ["**/decisions.md", "**/decision-log.md", "**/decision_log.md", "**/decisionlog.md"]
  },
  "lines": 400,
  "entries": {
    "heading": [
      { "level": 2, "pattern": "^(\\d{4}-\\d{2}-\\d{2})[ :—–\\-]{1,5}(.{1,200})$", "date": 1, "title": 2 },
      { "level": 2, "pattern": "^(.{1,200}) {0,3}[(\\[](\\d{4}-\\d{2}-\\d{2})[)\\]]$", "title": 1, "date": 2 },
      { "level": 2, "pattern": "^(.{1,200}) {1,3}[—–\\-] {1,3}(\\d{4}-\\d{2}-\\d{2})$", "title": 1, "date": 2 },
      { "level": 2, "pattern": "^(.{1,200})$", "title": 1 }
    ],
    "fields": {
      "date": [
        { "in": "top", "first": 6, "pattern": "^[-*]? {0,3}\\*{0,2}(?:date|decided)\\*{0,2}:\\*{0,2} {0,3}(\\d{4}-\\d{2}-\\d{2})" }
      ],
      "status": [
        { "in": "top", "first": 6, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}([a-z]{3,20})" }
      ],
      "marks": [
        { "kind": "superseded", "in": "top", "first": 6, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}(?:superseded|replaced) by:? {0,3}\\[([^\\]]{1,120})\\]\\(([^)\\s]{1,200})\\)", "name": 1, "by": 2 },
        { "kind": "superseded", "in": "top", "first": 6, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}(?:superseded|replaced) by:? {0,3}([^\\[\\s][^\\[]{0,119})$", "name": 1 },
        { "kind": "superseded", "in": "top", "first": 6, "pattern": "^>? {0,3}\\*{0,2}(?:superseded|replaced) by\\b" },
        { "kind": "deprecated", "in": "top", "first": 6, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}deprecated\\b" }
      ]
    }
  }
}
