{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "rfc",
  "owner": "@Genterai",
  "records": true,
  "matches": {
    "files": ["**/rfcs/**/*.{md,adoc}", "**/rfc/**/*.{md,adoc}", "**/text/????-*.md", "**/active-rfcs/*.md"]
  },
  "lines": 60,
  "fields": {
    "date": [
      { "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}(?:start date|start-date|created|date|creation-date|last updated|last-updated|updated)[*_]{0,2}:[*_]{0,2} {0,3}[\"']?(\\d{4}-\\d{2}-\\d{2}|\\d{1,2}-[a-z]{3}-\\d{4})" },
      { "in": "front-matter", "pattern": "^(?:start-date|date|created|creation-date|last-updated): {0,3}[\"']?(\\d{4}-\\d{2}-\\d{2})" },
      { "in": "top", "first": 30, "pattern": "^\\| {0,3}[*_]{0,2}(?:updated|last updated|date|created|start date)[*_]{0,2} {0,20}\\| {0,3}(\\d{4}-\\d{2}-\\d{2})" },
      { "in": "heading", "pattern": "^rfc #?\\d{1,5} {1,3}[-—–] {1,3}(\\d{4}-\\d{2}-\\d{2}) {1,3}[-—–] " }
    ],
    "status": [
      { "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_\"']{0,2}([a-z]{3,20})" },
      { "in": "front-matter", "pattern": "^(?:status|stage|state): {0,3}[\"']?([a-z]{3,20})" },
      { "in": "top", "first": 30, "pattern": "^\\| {0,3}[*_]{0,2}status[*_]{0,2} {0,20}\\| {0,3}[*_\\[]{0,2}([a-z]{3,20})" }
    ],
    "marks": [
      { "kind": "superseded", "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_]{0,2}(?:replaced|superseded|obsoleted) by:? {0,3}\\[([^\\]]{1,120})\\]\\(([^)\\s]{1,200})\\)", "name": 1, "by": 2 },
      { "kind": "superseded", "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_]{0,2}(?:replaced|superseded|obsoleted) by:? {0,3}(rfc[- #]?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "{id:04}-*.md" },
      { "kind": "superseded", "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_]{0,2}(?:replaced|superseded|obsoleted) by:? {0,3}([^\\[\\s*_][^\\[*]{0,119})", "name": 1 },
      { "kind": "superseded", "in": "top", "first": 12, "pattern": "^(?:in short, |in short )?this rfc (?:was|has been|is) superseded by \\[?(rfc[- #]?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "{id:04}-*.md" },
      { "kind": "deprecated", "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_]{0,2}deprecated\\b" },
      { "kind": "obsolete", "in": "top", "first": 30, "pattern": "^[-*:]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_]{0,2}obsolete\\b" }
    ]
  }
}
