{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "nep",
  "owner": "@Genterai",
  "records": true,
  "matches": {
    "files": ["**/neps/nep-*.{rst,md}"]
  },
  "lines": 60,
  "fields": {
    "date": [
      { "in": "top", "first": 30, "pattern": "^:created: {0,3}(\\d{4}-\\d{2}-\\d{2}|\\d{1,2}-[a-z]{3}-\\d{4})" }
    ],
    "status": [
      { "in": "top", "first": 30, "pattern": "^:status: {0,3}([a-z]{3,20})" }
    ],
    "marks": [
      { "kind": "superseded", "in": "top", "first": 30, "pattern": "^:replaced-by: {0,3}(?::ref:`)?(nep ?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "nep-{id:04}-*.rst" }
    ]
  }
}
