{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "changelog",
  "owner": "@Genterai",
  "matches": {
    "files": ["**/{CHANGELOG,CHANGES,HISTORY,RELEASES}{,.md,.markdown,.txt}"]
  },
  "lines": 400,
  "entries": {
    "heading": [
      { "level": 2, "pattern": "^\\[?v?(\\d{1,4}\\.\\d{1,4}[0-9a-z.+\\-]{0,30})\\]?.{0,200}\\b(\\d{4}-\\d{2}-\\d{2})\\)?$", "title": 1, "date": 2 },
      { "level": 2, "pattern": "^\\[?(unreleased|v?\\d{1,4}\\.\\d{1,4}[0-9a-z.+\\-]{0,30})\\b", "title": 1 }
    ],
    "fields": {
      "marks": [
        { "kind": "deprecated", "in": "section", "section": "^deprecated$", "pattern": "^[-*+] {1,3}(.{1,200})", "name": 1 },
        { "kind": "removed", "in": "section", "section": "^removed$", "pattern": "^[-*+] {1,3}(.{1,200})", "name": 1 },
        { "kind": "deprecated", "in": "any", "pattern": "^[-*+] {1,3}\\*{0,2}deprecated\\*{0,2}:\\*{0,2} {0,3}(.{1,200})", "name": 1 },
        { "kind": "removed", "in": "any", "pattern": "^[-*+] {1,3}\\*{0,2}removed\\*{0,2}:\\*{0,2} {0,3}(.{1,200})", "name": 1 }
      ]
    }
  }
}
