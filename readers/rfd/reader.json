{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "rfd",
  "owner": "@Genterai",
  "records": true,
  "matches": {
    "files": ["**/rfd/*.{md,adoc}", "**/rfds/*.{md,adoc}", "**/rfd/*/README.{md,adoc}", "**/rfds/*/README.{md,adoc}"]
  },
  "lines": 40,
  "fields": {
    "date": [
      { "in": "front-matter", "pattern": "^(?:date|created|creation-date): {0,3}[\"']?(\\d{4}-\\d{2}-\\d{2})" },
      { "in": "top", "first": 16, "pattern": "^:(?:date|created): {0,3}(\\d{4}-\\d{2}-\\d{2})" }
    ],
    "status": [
      { "in": "front-matter", "pattern": "^(?:state|status): {0,3}[\"']?([a-z]{3,20})" },
      { "in": "top", "first": 16, "pattern": "^:(?:state|status): {0,3}([a-z]{3,20})" }
    ],
    "marks": [
      { "kind": "superseded", "in": "front-matter", "pattern": "^(?:state|status): {0,3}[\"']?(?:superseded|replaced) by:? {0,3}\\[?(rfd[- ]?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "{id:04}-*.md" },
      { "kind": "superseded", "in": "top", "first": 16, "pattern": "^(?:>|\\*\\*|_)? {0,3}this rfd (?:is|was|has been) superseded by \\[?(rfd[- ]?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "{id:04}-*.md" },
      { "kind": "deprecated", "in": "front-matter", "pattern": "^(?:state|status): {0,3}[\"']?deprecated\\b.{0,40}\\b(rfd[- ]?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "{id:04}-*.md" },
      { "kind": "deprecated", "in": "front-matter", "pattern": "^(?:state|status): {0,3}[\"']?deprecated\\b" },
      { "kind": "deprecated", "in": "top", "first": 16, "pattern": "^:(?:state|status): {0,3}deprecated\\b" }
    ]
  }
}
