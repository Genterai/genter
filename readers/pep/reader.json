{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "pep",
  "owner": "@Genterai",
  "records": true,
  "matches": {
    "files": ["**/peps/pep-*.{rst,md,txt}"]
  },
  "lines": 60,
  "fields": {
    "date": [
      { "in": "top", "first": 30, "pattern": "^created: {0,3}(\\d{1,2}-[a-z]{3}-\\d{4}|\\d{4}-\\d{2}-\\d{2})" }
    ],
    "status": [
      { "in": "top", "first": 30, "pattern": "^status: {0,3}([a-z]{3,20})" }
    ],
    "marks": [
      { "kind": "superseded", "in": "top", "first": 30, "pattern": "^superseded-by: {0,3}(?:pep-|pep |pep)?(\\d{1,5})\\b", "name": 1, "id": 1, "place": "pep-{id:04}.*" }
    ]
  }
}
