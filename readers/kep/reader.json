{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "kep",
  "owner": "@Genterai",
  "records": true,
  "matches": {
    "files": ["**/keps/**/kep.yaml"]
  },
  "lines": 80,
  "fields": {
    "date": [
      { "in": "top", "first": 40, "pattern": "^creation-date: {0,3}[\"']?(\\d{4}-\\d{2}-\\d{2})" },
      { "in": "top", "first": 40, "pattern": "^last-updated: {0,3}[\"']?(\\d{4}-\\d{2}-\\d{2})" }
    ],
    "status": [
      { "in": "top", "first": 40, "pattern": "^status: {0,3}[\"']?([a-z]{3,20})" }
    ],
    "marks": [
      { "kind": "superseded", "in": "top", "first": 40, "pattern": "^status: {0,3}[\"']?(?:replaced|superseded)\\b" }
    ]
  }
}
