{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "pip",
  "owner": "@Genterai",
  "records": true,
  "matches": {
    "files": ["**/pip/pip-*.md", "**/pips/pip-*.md"]
  },
  "lines": 40,
  "fields": {
    "date": [
      { "in": "top", "first": 12, "pattern": "^[-*]? {0,3}[*_]{0,2}(?:date|created|start date|last updated)[*_]{0,2}:[*_]{0,2} {0,3}(\\d{4}-\\d{2}-\\d{2})" }
    ],
    "status": [
      { "in": "top", "first": 12, "pattern": "^[-*]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}[*_\\[\"']{0,2}([a-z]{3,20})" }
    ],
    "marks": [
      { "kind": "superseded", "in": "top", "first": 12, "pattern": "^[-*]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}(?:superseded|replaced) by:? {0,3}\\[([^\\]]{1,120})\\]\\(([^)\\s]{1,200})\\)", "name": 1, "by": 2 },
      { "kind": "superseded", "in": "top", "first": 12, "pattern": "^[-*]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}(?:superseded|replaced) by:? {0,3}(pip[- ]?(\\d{1,4}))\\b", "name": 1, "id": 2, "place": "pip-{id}.md" },
      { "kind": "deprecated", "in": "top", "first": 12, "pattern": "^[-*]? {0,3}[*_]{0,2}status[*_]{0,2}:[*_]{0,2} {0,3}deprecated\\b" }
    ]
  }
}
