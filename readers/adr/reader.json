{
  "$schema": "../reader.schema.json",
  "dsl": 1,
  "name": "adr",
  "owner": "@Genterai",
  "matches": {
    "files": ["**/adr/*.md", "**/adrs/*.md", "**/decisions/*.md", "**/architecture/decisions/*.md", "**/architecture-decisions/*.md", "**/decision-records/*.md"]
  },
  "lines": 80,
  "fields": {
    "date": [
      { "in": "front-matter", "pattern": "^date: {0,3}[\"']?(\\d{4}-\\d{2}-\\d{2})" },
      { "in": "top", "first": 12, "pattern": "^[-*]? {0,3}\\*{0,2}date\\*{0,2}:\\*{0,2} {0,3}(\\d{4}-\\d{2}-\\d{2})" }
    ],
    "status": [
      { "in": "front-matter", "pattern": "^status: {0,3}[\"']?([a-z]{3,20})" },
      { "in": "top", "first": 12, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}([a-z]{3,20})" },
      { "in": "section", "section": "^status$", "first": 5, "pattern": "^([a-z]{3,20})\\b" }
    ],
    "marks": [
      { "kind": "superseded", "in": "front-matter", "pattern": "^status: {0,3}[\"']?superseded by:? {0,3}\\[([^\\]]{1,120})\\]\\(([^)\\s]{1,200})\\)", "name": 1, "by": 2 },
      { "kind": "superseded", "in": "front-matter", "pattern": "^status: {0,3}[\"']?superseded by:? {0,3}([^\"'\\[\\s][^\"'\\[]{0,119})", "name": 1 },
      { "kind": "superseded", "in": "top", "first": 12, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}superseded by:? {0,3}\\[([^\\]]{1,120})\\]\\(([^)\\s]{1,200})\\)", "name": 1, "by": 2 },
      { "kind": "superseded", "in": "top", "first": 12, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}superseded by:? {0,3}([^\\[\\s][^\\[]{0,119})$", "name": 1 },
      { "kind": "superseded", "in": "section", "section": "^status$", "first": 5, "pattern": "^superseded by:? {0,3}\\[([^\\]]{1,120})\\]\\(([^)\\s]{1,200})\\)", "name": 1, "by": 2 },
      { "kind": "superseded", "in": "section", "section": "^status$", "first": 5, "pattern": "^superseded by:? {0,3}([^\\[\\s][^\\[]{0,119})$", "name": 1 },
      { "kind": "deprecated", "in": "front-matter", "pattern": "^status: {0,3}[\"']?deprecated\\b" },
      { "kind": "deprecated", "in": "top", "first": 12, "pattern": "^[-*]? {0,3}\\*{0,2}status\\*{0,2}:\\*{0,2} {0,3}deprecated\\b" },
      { "kind": "deprecated", "in": "section", "section": "^status$", "first": 5, "pattern": "^deprecated\\b" }
    ]
  }
}
